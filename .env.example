# ==========================================
# RESONANCE (SPOTIFY CLONE) ENVIRONMENT VARIABLES
# ==========================================
# Instructions: 
# 1. Copy this file and rename it to `.env`
# 2. Fill in the values for your specific APIs below.
# 3. Restart your Vite development server (`npm run dev`) for changes to take effect.

# ------------------------------------------
# 1. SPOTIFY WEB API (For real music data)
# ------------------------------------------
# How to get these:
# 1. Go to the Spotify Developer Dashboard: https://developer.spotify.com/dashboard
# 2. Log in with your Spotify account and click "Create app".
# 3. Give your app a name (e.g., "Resonance") and description.
# 4. For "Redirect URI", enter: http://localhost:5173/callback
# 5. Check the Developer Terms of Service and click Save.
# 6. Once created, click on "Settings" in your app dashboard to find your Client ID and Client Secret.

VITE_SPOTIFY_CLIENT_ID="your_spotify_client_id_here"
VITE_SPOTIFY_CLIENT_SECRET="your_spotify_client_secret_here"
VITE_SPOTIFY_REDIRECT_URI="http://localhost:5173/callback"

# ------------------------------------------
# 2. BACKEND API & DATABASE (For Auth & Custom Playlists)
# ------------------------------------------
# If you want to replace our LocalStorage with a real database (like Supabase, 
# Firebase, or a custom Node.js backend) to handle user logins and store playlists:

# Example: Custom Node/Express Backend
VITE_API_BASE_URL="http://localhost:3000/api"

# ------------------------------------------
# 3. CLERK AUTHENTICATION
# ------------------------------------------
# How to get this:
# 1. Go to the Clerk Dashboard: https://dashboard.clerk.com/
# 2. Create a new application.
# 3. In the API Keys section, copy the "Publishable Key".
VITE_CLERK_PUBLISHABLE_KEY="your_clerk_publishable_key_here"

# Example: Supabase (Go to supabase.com -> New Project -> Project Settings -> API)
# VITE_SUPABASE_URL="your_supabase_project_url"
# VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"
